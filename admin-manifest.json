{
  "id": "./admin-pwa",
  "name": "Harborlight Hotel Admin",
  "short_name": "Hotel Admin",
  "description": "Harborlight property management console for reservations, rooms, website content, payments and OTA channels.",
  "start_url": "./admin.html",
  "scope": "./admin.html",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "orientation": "any",
  "background_color": "#f4f2ed",
  "theme_color": "#0d1b1e",
  "icons": [
    {
      "src": "https://hotel.mdmsportal.uk/api/public/brand-icon/192",
      "sizes": "192x192",
      "purpose": "any maskable"
    },
    {
      "src": "https://hotel.mdmsportal.uk/api/public/brand-icon/512",
      "sizes": "512x512",
      "purpose": "any maskable"
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-existing"
  }
}
